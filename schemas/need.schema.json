{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aalexstan/project-Atlas/blob/main/schemas/need.schema.json",
  "title": "Atlas need route",
  "type": "object",
  "required": ["schema_version", "id", "name", "name_ru", "status", "last_verified", "primary_question", "related_apis", "related_comparisons", "related_procurement", "decision_paths", "open_questions", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "name_ru": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "last_verified": {"type": "string", "format": "date"},
    "primary_question": {"type": "string", "minLength": 1},
    "related_apis": {"type": "array", "items": {"type": "string"}},
    "related_comparisons": {"type": "array", "items": {"type": "string"}},
    "related_procurement": {"type": "array", "items": {"type": "string"}},
    "decision_paths": {"type": "array"},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
